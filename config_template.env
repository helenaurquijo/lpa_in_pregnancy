# Copy this file to config.env and update the paths for your workspace

# Project configuration
mrpregdir="/path/to/mrpreg/directory"
p_id="your_project_id"
rel_path="/your/relative/path"
projectdir="/path/to/your/project/directory"
projectdir_rdsf="/path/to/rdsf/project"

# External data sources
ukb_pqtl_dir="/path/to/ukb/pqtl/data/"
ukb_metadata="/path/to/ukb/metadata/"

# API tokens (replace with your own)
OPENGWAS_JWT="your_opengwas_jwt_token"
LDLINK_TOKEN="your_ldlink_token"

# Specific data files
conmal="/path/to/conmal/data.txt.gz"
pph_gwas_url="url_or_path_to_pph_data"
refpan="/path/to/reference/panel"
conmalwlm="/path/to/conmal/wlm/results/"
mrpregrawgwas="/path/to/mrpreg/raw/gwas/files/"
